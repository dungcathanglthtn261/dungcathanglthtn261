using "platforms/cpus/stm32f103.repl"

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// stm32f103.repl thieu vung bit-band; HAL F1 bat HSI/PLL qua alias 0x42xxxxxx (vd __HAL_RCC_PLL_ENABLE).
bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

// stm32f103.repl chi Tag RCC_CR co dinh, CFGR.SWS khong bao PLL -> HAL_RCC_ClockConfig timeout.
// Mo phong RCC toi thieu: co READY theo bit ON, SWS = SW. Cho phep code HSE + PLL x9 (72 MHz) cua Ca chay.
rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x00: 0x83}
elif request.IsRead:
    o = request.Offset
    v = regs.get(o, 0)
    if o == 0x00:   # CR: HSIRDY(1)=HSION(0), HSERDY(17)=HSEON(16), PLLRDY(25)=PLLON(24)
        v = (v & ~((1 << 1) | (1 << 17) | (1 << 25))) | ((v & 1) << 1) | ((v >> 16 & 1) << 17) | ((v >> 24 & 1) << 25)
    elif o == 0x04: # CFGR: SWS[3:2] = SW[1:0]
        v = (v & ~0xC) | ((v & 3) << 2)
    request.Value = v
elif request.IsWrite:
    regs[request.Offset] = request.Value
'''

// FLASH_ACR: HAL doc lai LATENCY sau khi ghi; Renode khong mo phong -> luu lai gia tri ghi.
flashCtrl: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    script: "regs = {} if request.IsInit else regs; request.Value = regs.get(request.Offset, 0) if request.IsRead else request.Value; regs.update({request.Offset: request.Value} if request.IsWrite else {})"

relay: Miscellaneous.LED @ gpioPortA
    invert: true

gpioPortA:
    4 -> relay@0

// stm32f103.repl khong co ADC1; STM32_ADC cua Renode la ban F4 (SWSTART bit 30, khong co CAL) nen tu mo phong.
// Doi gia tri cam bien tu monitor:  sysbus WriteDoubleWord 0x400127FC <raw 0..4095>   (kho ~3000, uot ~1300)
adc1: Python.PythonPeripheral @ sysbus 0x40012400
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    raw = 2500
elif request.IsRead:
    o = request.Offset
    if o == 0x00:   request.Value = 0x12                                    # SR: EOC|STRT -> PollForConversion OK
    elif o == 0x08: request.Value = regs.get(o, 0) & ~((1 << 2) | (1 << 3) | (1 << 22))  # CR2: CAL/RSTCAL/SWSTART tu xoa
    elif o == 0x4C or o == 0x3FC: request.Value = raw                       # DR
    else:           request.Value = regs.get(o, 0)
elif request.IsWrite:
    if request.Offset == 0x3FC: raw = request.Value & 0xFFF
    else: regs[request.Offset] = request.Value
'''

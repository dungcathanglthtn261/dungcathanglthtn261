ca:
	git fetch origin Ca
	rm -rf $(CA_SNAPSHOT) && mkdir -p $(CA_SNAPSHOT)
	git -C ../.. archive FETCH_HEAD:firmware | tar -x -C $(CA_SNAPSHOT)
	@git log -1 --format='Da lay nhanh Ca: %h %s' FETCH_HEAD


# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
# Driver lcd16x02/relay_pump/soil_sensor nam o firmware/middleware (nhu nhanh Ca)
MW_SOURCES = lcd16x02.c relay_pump.c soil_sensor.c

flowchart TD
  A([Task_SensorRead<br/>chu kỳ 1000 ms]) --> A1[Hiệu chuẩn ADC1]
  A1 --> B[Đọc ADC kênh PA0 8 lần]
  B --> K{Đọc ADC lỗi?}
  K -- Có --> L[ok = false] --> I
  K -- Không --> C[Tính trung bình raw]
  C --> D["Quy đổi %:<br/>soil = (raw − ADC_DRY)·100 / (ADC_WET − ADC_DRY)"]
  D --> E{soil &lt; 0?}
  E -- Có --> F[soil = 0] --> M
  E -- Không --> G{soil &gt; 100?}
  G -- Có --> H[soil = 100] --> M
  G -- Không --> M[ok = true]
  M --> I[Khóa mutex<br/>Nếu ok: ghi soil<br/>sensor_valid = ok<br/>Mở mutex]
  I --> J[osDelay 1000 ms]
  J --> B
